nodes_alpha_beta = 0


# -------------------------
# MINIMAX
# -------------------------

def minimax():
    global nodes_minimax

    # A
    a1 = 3
    a2 = 5

    nodes_minimax += 2

    A = min(a1, a2)

    # B
    b1 = 2
    b2 = 9

    nodes_minimax += 2

    B = min(b1, b2)

    best = max(A, B)

    return best


